# NaviPlayer configuration. Copy this file to `.env` and edit it.
#
# The public base URL of your Navidrome server. This is the only setting
# NaviPlayer needs. It is NOT a secret: it is compiled into the JavaScript the
# browser downloads, so never put usernames, passwords or tokens here.
#
# - Include Navidrome's base path if it has one (ND_BASEURL), e.g.
#   https://example.com/navidrome
# - No trailing slash needed, and no query string.
# - If NaviPlayer is served over HTTPS, this must be HTTPS too.
#
# Static builds (`npm run build`) read it at build time: rebuild after changing.
# The bundled server (`npm run server`, Docker) reads it at startup and proxies
# Navidrome on its own origin: restart after changing.
VITE_NAVIDROME_URL=https://music.example.com

# Optional: the app's display name — sidebar, login screen, browser tab and the
# installed app. Defaults to NaviPlayer when unset or blank. Public, like the URL
# above. Read at the same moments: build time for static builds, startup for the
# bundled server.
# VITE_APP_NAME=NaviPlayer

# -----------------------------------------------------------------------------
# Bundled server only (`npm run server`, Docker). Everything below stays on the
# server: none of it reaches the browser, and a static build ignores it. All
# optional; leave commented out to keep the default.
# -----------------------------------------------------------------------------

# Port the server listens on. Docker: fixed at 8080 inside the container; the
# compose files publish it on 8680.
# PORT=8080

# Folder of built app files to serve.
# DIST_DIR=./dist

# Admin uploads and the "organize" tool. Point it at the folder Navidrome scans;
# leave unset to keep uploads off. Docker: this is the path *inside* the
# container (/music), and MUSIC_HOST_DIR below is the folder on your machine.
# MUSIC_DIR=/srv/music
# MUSIC_HOST_DIR=./music

# Largest upload accepted, in megabytes (one file or one ZIP). Uploads are
# processed in memory, so keep this within what the host can spare.
# UPLOAD_MAX_MB=2048

# Rich link-preview cards (title + cover) for chat apps and social sites. Use a
# dedicated, READ-ONLY Navidrome account: these are real credentials. They are
# read by the server only — which is why they have no VITE_ prefix; never give
# them one — and .env is kept out of git and Docker images. Both unset = off.
# NAVIDROME_OG_USER=
# NAVIDROME_OG_PASS=
