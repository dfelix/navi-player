{
  "extends": "@vue/tsconfig/tsconfig.json",
  "include": [
    "vite.config.ts",
    "src/lib/appName.ts",
    "server/lrclib.ts",
    "jest.config.ts",
    "eslint.config.ts",
    "playwright.config.ts",
    "e2e/**/*",
    "scripts/**/*"
  ],
  "compilerOptions": {
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"]
  }
}
