{
  "name": "navi-player",
  "version": "0.1.8",
  "description": "A dark, album-art-first web client for a single Navidrome music library",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "npm run type-check && vite build && npm run build:server",
    "build:server": "tsc -p tsconfig.server.json",
    "preview": "vite preview",
    "server": "node dist-server/index.js",
    "server:dev": "tsx watch server/index.ts",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix --cache",
    "lint:check": "eslint . --cache",
    "format": "prettier --write src/ tests/ server/",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "icons": "tsx scripts/generate-icons.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "fflate": "^0.8.3",
    "hono": "^4.13.13",
    "music-metadata": "^12.2.1"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@playwright/test": "^1.61.1",
    "@tanstack/vue-query": "^5.104.3",
    "@types/culori": "^4.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "babel-jest": "^29.7.0",
    "culori": "^4.0.2",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jiti": "^2.7.0",
    "js-md5": "^0.9.2",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^4.1.0",
    "prettier": "^3.9.10",
    "reka-ui": "^2.11.0",
    "sharp": "^0.35.5",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.14",
    "vue-router": "^5.4.0",
    "vue-tsc": "^3.3.13"
  }
}
